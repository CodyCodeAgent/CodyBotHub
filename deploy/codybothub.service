[Unit]
# Example only. Replace /path/to/CodyBotHub and CLI paths, or use
# skills/codybothub-setup/scripts/install-service.sh to generate a local unit.
Description=CodyBotHub Feishu Bot Management Platform
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=-%h/.config/codybothub/proxy.env
Type=simple
WorkingDirectory=/path/to/CodyBotHub
Environment=NODE_ENV=production
Environment=CODY_BOT_HUB_HOST=::
Environment=CODY_BOT_HUB_PORT=3003
Environment=CODY_BOT_HUB_DATA_DIR=/path/to/CodyBotHub/.data
Environment=CODY_BOT_HUB_WEB_DIST=/path/to/CodyBotHub/apps/web/dist
Environment=CODY_BOT_HUB_CODEX_COMMAND=codex
Environment=CODY_BOT_HUB_TRAEX_COMMAND=traex
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /path/to/CodyBotHub/apps/server/dist/main.js
KillSignal=SIGTERM
TimeoutStopSec=20min
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
